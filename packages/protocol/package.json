{
  "name": "@pizzapi/protocol",
  "version": "0.1.32",
  "description": "Typed Socket.IO event contracts shared by PizzaPi's server, CLI, UI and extensions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pizzaface/PizzaPi.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/Pizzaface/PizzaPi",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build --force",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
