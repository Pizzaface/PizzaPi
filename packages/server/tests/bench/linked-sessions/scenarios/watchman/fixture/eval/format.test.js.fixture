import { test, expect } from "bun:test";
import { formatAnswer } from "../src/format.js";

test("Q27: answer ends with the scope line", () => {
  expect(formatAnswer("Restart the agent.  ", "tenant-a")).toBe("Restart the agent.\n\nScope: tenant-a");
});

test("Q28: scope line is present even for one-word answers", () => {
  expect(formatAnswer("Yes", "acme")).toBe("Yes\n\nScope: acme");
});
